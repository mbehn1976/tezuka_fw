config BR2_PACKAGE_KALIBRATE
        bool "kalibrate"
        depends on BR2_TOOLCHAIN_HAS_THREADS
        select BR2_PACKAGE_LIBIIO0
        
        select BR2_PACKAGE_FFTW 
        select BR2_PACKAGE_FFTW_DOUBLE
        select BR2_PACKAGE_FFTW_FAST
             help
          kalibrate calibration tool

          https://github.com/F5OEO/kalibrate-hydrasdr
comment "kalibrate needs a toolchain w/ threads"
        depends on !BR2_TOOLCHAIN_HAS_THREADS
